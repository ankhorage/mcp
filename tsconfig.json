{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
