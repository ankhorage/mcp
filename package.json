{
  "name": "@ankhorage/mcp",
  "version": "0.3.0",
  "description": "Secure, provider-neutral MCP runtime and Ankh CLI provider.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/ankhorage/mcp#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/mcp.git"
  },
  "keywords": [
    "ankhorage",
    "mcp",
    "model-context-protocol",
    "security"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "ankh": {
    "category": "mcp",
    "capabilities": [
      {
        "id": "mcp.add",
        "owner": "@ankhorage/mcp",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "mcp.list",
        "owner": "@ankhorage/mcp",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "mcp.doctor",
        "owner": "@ankhorage/mcp",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "mcp.serve",
        "owner": "@ankhorage/mcp",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      }
    ],
    "provider": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "test:standalone": "bun run build && bun test src/standalone.test.ts",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "prepack": "bun run build",
    "version-packages": "ankhorage-changeset version",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/ankh": "^0.13.2",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.3.32",
    "@ankhorage/paradox": "^0.3.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
